{
  "name": "rspack-mfe1",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rspack-mfe1/src",
  "prefix": "angular-architects",
  "tags": ["scope:demo"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/rspack-mfe1"],
      "dependsOn": [
        {
          "projects": ["mf"],
          "target": "build"
        }
      ],
      "options": {
        "command": "rspack build",
        "cwd": "apps/rspack-mfe1"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["mf"],
          "target": "build"
        }
      ],
      "options": {
        "command": "rspack serve",
        "cwd": "apps/rspack-mfe1"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/rspack-mfe1/**/*.ts",
          "apps/rspack-mfe1/**/*.html"
        ]
      }
    }
  }
}
